# Rubric - deployment configuration (repo root).
# Copy to .env and fill in real values. NEVER commit .env. NEVER print or log these values.
# Used by deploy/deploy.mjs, deploy/seed.mjs, and integration tests (gltest.config.yaml).

# Private key of a GenLayer Testnet Bradbury account funded with GEN.
# Faucet: https://testnet-faucet.genlayer.foundation  (claim once per 24h)
ACCOUNT_PRIVATE_KEY=

# Optional: wallet that receives the protocol fee on released payments (defaults to the deployer).
FEE_RECIPIENT=

# Optional: protocol fee in basis points charged on funds released to the freelancer.
# Default 100 = 1%. Max 1000 = 10%.
FEE_BPS=100

# Set by deploy/deploy.mjs after a successful deployment (the deployed contract address).
CONTRACT_ADDRESS=
