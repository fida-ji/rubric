# Rubric frontend configuration.
# Optional. If unset, the app uses the deployed contract address baked into src/config.ts,
# so the hosted site works with no configuration.
#
# On Netlify, set this as a Site environment variable (Site settings -> Environment variables).
# It is a public address, not a secret. Never put a private key here.
VITE_CONTRACT_ADDRESS=0x5688061Df3b231cdF3D4703b8D9cC7234723D2A8
